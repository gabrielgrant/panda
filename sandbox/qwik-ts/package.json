{
  "name": "sandbox-qwik",
  "description": "Panda + Qwik 2 (Qwik Router) sandbox",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "codegen": "panda codegen",
    "cssgen": "panda cssgen",
    "build": "pnpm codegen && qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "dev": "pnpm codegen && vite --mode ssr",
    "preview": "qwik build preview && vite preview --open",
    "qwik": "qwik",
    "e2e": "node e2e.mjs"
  },
  "devDependencies": {
    "@pandacss/cli": "workspace:*",
    "@pandacss/preset-base": "workspace:*",
    "@pandacss/preset-panda": "workspace:*",
    "@pandacss/vite": "workspace:*",
    "@qwik.dev/core": "2.0.0-rc.4",
    "@qwik.dev/router": "2.0.0-rc.4",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3",
    "undici": "7.29.0",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "5.1.4"
  },
  "type": "module"
}
